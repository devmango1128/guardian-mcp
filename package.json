  "description": "MCP server that provides a recoverable safety layer against destructive filesystem operations and commands run by AI coding agents.",
  "type": "module",
  "bin": {
    "safe-agent-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
